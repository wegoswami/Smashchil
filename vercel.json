{
  "framework": "vite",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/posts",
      "destination": "/posts/index.html"
    },
    {
      "source": "/posts/:slug",
      "destination": "/posts/:slug/index.html"
    },
    {
      "source": "/post/:slug",
      "destination": "/posts/:slug/index.html"
    },
    {
      "source": "/pages",
      "destination": "/pages/index.html"
    },
    {
      "source": "/pages/:slug",
      "destination": "/pages/:slug/index.html"
    },
    {
      "source": "/page/:slug",
      "destination": "/pages/:slug/index.html"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/disclaimer",
      "destination": "/disclaimer/index.html"
    },
    {
      "source": "/dmca",
      "destination": "/dmca/index.html"
    },
    {
      "source": "/faq",
      "destination": "/faq/index.html"
    },
    {
      "source": "/((?!posts|post|pages|page|blog|privacy|terms|about|contact|disclaimer|dmca|faq|assets|icon\\.svg|favicon\\.ico|manifest\\.json|robots\\.txt|sitemap\\.xml|ads\\.txt|llms\\.txt|\\.well-known).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(posts|post|pages|page|blog|privacy|terms|about|contact|disclaimer|dmca|faq)(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(icon\\.svg|favicon\\.ico|manifest\\.json|robots\\.txt|sitemap\\.xml|ads\\.txt|llms\\.txt|\\.well-known/(.*))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ]
}
